# ==============================================================================
# CareerHub Environment Configuration
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit `.env` or `.env.local` to version control.
# - Keep backend secrets STRICTLY on the server side (NO NEXT_PUBLIC_ prefix).
# - Only variables prefixed with NEXT_PUBLIC_ will be exposed to the client browser.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Application URL (Canonical base URL for metadata, sitemaps, open-graph)
NEXT_PUBLIC_APP_URL=https://careerhub.example.com

# Server-Side Only Secrets (NEVER expose to client)
# ------------------------------------------------------------------------------
# PostgreSQL / Supabase / Prisma Database Connection URL
DATABASE_URL=postgresql://careerhub_user:your_secure_password_here@localhost:5432/careerhub_db?schema=public

# Session & JWT encryption secret (Generate with: openssl rand -base64 32)
AUTH_SECRET=replace_with_a_secure_random_64_character_hex_or_base64_string

# Cloud Storage / S3 / R2 Bucket Credentials (for resume PDF uploads)
STORAGE_ACCESS_KEY_ID=your_storage_access_key
STORAGE_SECRET_ACCESS_KEY=your_storage_secret_key
STORAGE_BUCKET_NAME=careerhub-resumes
STORAGE_REGION=us-east-1

# Bot Protection / Captcha Verification Server Secret (e.g. Cloudflare Turnstile or reCAPTCHA v3)
RECAPTCHA_SECRET_KEY=your_recaptcha_server_secret_key_here

# Analytics Salt (Used for server-side anonymized IP hashing)
ANALYTICS_SALT=your_random_salt_for_ip_hashing

# Email Delivery Provider (e.g. Resend, SendGrid)
EMAIL_SERVER_API_KEY=your_email_api_key_here
EMAIL_FROM_ADDRESS=notifications@careerhub.example.com

# Client-Safe Public Variables (Prefixed with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_public_site_key
NEXT_PUBLIC_ANALYTICS_ENABLED=true
